# Copy to .env or export these before `node server.js`. Everything is optional.
PORT=8080
DATA_FILE=data/db.json
PUBLIC_URL=https://your-school-address.example      # the address students open (used in QR codes and link previews)
TRUST_PROXY=1                                       # set when behind Cloudflare/Netlify/nginx
OPERATOR_KEY=change-me-long-random                  # opens /operator.html (billing, feedback)
# Feedback email (Gmail: use an App password, needs 2-Step Verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=
FEEDBACK_TO=techbenedict1@gmail.com
# SMS, push and payments: see DEPLOY.md
