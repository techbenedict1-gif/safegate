{"id": "/", "name": "SafeGate: campus gate pass", "short_name": "SafeGate", "description": "Sign out and in at the school gate in one tap. Works without internet. Your family knows you are safe and help is one button away.", "lang": "en", "dir": "ltr", "start_url": "./?source=app", "scope": "./", "display": "standalone", "orientation": "portrait", "background_color": "#f3f6f8", "theme_color": "#0b5d7a", "categories": ["education", "utilities", "lifestyle"], "icons": [{"src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"}, {"src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"}, {"src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}, {"src": "icon.svg", "sizes": "any", "type": "image/svg+xml"}], "shortcuts": [{"name": "Scan at the gate", "short_name": "Scan", "url": "./?go=scan", "icons": [{"src": "icon-192.png", "sizes": "192x192"}]}, {"name": "Emergency", "short_name": "SOS", "url": "./?go=sos", "icons": [{"src": "icon-192.png", "sizes": "192x192"}]}, {"name": "Safe walk", "short_name": "Safe walk", "url": "./?go=walk", "icons": [{"src": "icon-192.png", "sizes": "192x192"}]}], "screenshots": [{"src": "shot-home.png", "sizes": "780x1688", "type": "image/png", "form_factor": "narrow", "label": "Your gate pass on your phone"}, {"src": "shot-leave.png", "sizes": "780x1688", "type": "image/png", "form_factor": "narrow", "label": "Walk home with a safety timer"}]}