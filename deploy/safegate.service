# Copy to /etc/systemd/system/safegate.service, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now safegate
[Unit]
Description=SafeGate student security system
After=network.target

[Service]
WorkingDirectory=/opt/safegate
Environment=TRUST_PROXY=1 PORT=8080 DATA_FILE=/var/lib/safegate/db.json PUSH_SUBJECT=mailto:security@yourschool.edu
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
User=safegate
StateDirectory=safegate
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/safegate

[Install]
WantedBy=multi-user.target
